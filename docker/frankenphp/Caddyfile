# Configuracion FrankenPHP para Laravel 13 (Produccion)
{
    auto_https off
    http_port 80
}

:80 {
    root * /app/public

    # Compresion
    encode gzip zstd

    # Headers de seguridad
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }

    # Archivos estaticos con cache largo (Vite usa hash en nombres)
    @static path /build/* /favicon.ico /robots.txt
    header @static Cache-Control "public, max-age=31536000, immutable"

    php_server
}
